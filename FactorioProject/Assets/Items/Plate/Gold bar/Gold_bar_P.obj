v -0.115 0.000 -0.066
v  0.115 0.000 -0.066
v  0.115 0.000  0.066
v -0.115 0.000  0.066
v -0.111 0.006 -0.063
v  0.111 0.006 -0.063
v  0.111 0.006  0.063
